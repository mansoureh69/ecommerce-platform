# Copy to .env and supply generated secrets. Never commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=

# Host port for the API. Windows reserves 8002-8101 on some machines, so 8080 may be blocked.
API_PORT=

# Google sign-in (optional). OAuth "Web application" client id from Google Cloud Console; leave empty to disable.
# The storefront needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID (it is public, not a secret).
GOOGLE_CLIENT_ID=
